#!/bin/bash
# Baixa e prepara os dois modelos do laboratorio:
#   qwen3-8b-gpu       -> agente (RX 580, contexto 16k)
#   llm4decompile-cpu  -> refinador de pseudocodigo (so CPU/RAM)
set -euo pipefail

QWEN_BASE="${QWEN_BASE:-qwen3:8b}"
DECOMP_BASE="${DECOMP_BASE:-hf.co/DevQuasar/LLM4Binary.llm4decompile-6.7b-v2-GGUF:Q4_K_M}"
CONTEXTO="${CONTEXTO:-16384}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

pausa() { echo; read -r -p "Enter para fechar." _ || true; }
trap 'echo; echo "ERRO na linha $LINENO."; pausa' ERR

tem_persistencia() { [ -n "$(ls -A /run/live/persistence 2>/dev/null)" ]; }
if grep -qw 'boot=live' /proc/cmdline && ! mountpoint -q /modelos && ! tem_persistencia; then
    echo "ATENCAO: modo live SEM persistencia e sem particao MODELOS."
    echo "Os ~9 GB de modelos iriam para a memoria RAM e somem ao desligar."
    read -r -p "Continuar mesmo assim? [s/N] " r
    [ "${r,,}" = "s" ] || { pausa; exit 0; }
fi

until curl -fsS http://127.0.0.1:11434/api/version >/dev/null; do
    echo "Esperando o Ollama iniciar..."; sleep 2
done

echo "== 1/2 Agente: $QWEN_BASE =="
ollama pull "$QWEN_BASE"
printf 'FROM %s\nPARAMETER num_ctx %s\nPARAMETER num_gpu 99\n' "$QWEN_BASE" "$CONTEXTO" > "$TMP/Modelfile.qwen"
ollama create qwen3-8b-gpu -f "$TMP/Modelfile.qwen"

echo "== 2/2 Refinador: $DECOMP_BASE =="
ollama pull "$DECOMP_BASE"
cat > "$TMP/Modelfile.decomp" <<EOF
FROM $DECOMP_BASE
PARAMETER num_gpu 0
PARAMETER num_ctx 4096
PARAMETER temperature 0
PARAMETER num_predict 1024
TEMPLATE "{{ .Prompt }}"
EOF
ollama create llm4decompile-cpu -f "$TMP/Modelfile.decomp"

echo
echo "Modelos prontos:"
ollama list | grep -E 'qwen3-8b-gpu|llm4decompile-cpu' || true
pausa
