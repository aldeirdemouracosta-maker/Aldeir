[Unit]
Description=Ollama (IA local) - RX 580 via Vulkan
After=network-online.target rea-modelos-dir.service
Wants=rea-modelos-dir.service

[Service]
User=ollama
Group=ollama
ExecStart=/usr/local/bin/ollama serve
Restart=always
RestartSec=3
# Log legivel pelo Painel REA (botao "Verificar corte de prompt")
LogsDirectory=ollama
StandardOutput=append:/var/log/ollama/ollama.log
StandardError=inherit
# Modelos fora do sistema (particao MODELOS ou /modelos)
Environment="OLLAMA_MODELS=/modelos/ollama"
# RX 580 nao tem ROCm: usa Vulkan (Mesa RADV)
Environment="OLLAMA_VULKAN=1"
# 1 pedido por vez = o contexto inteiro vai para esse pedido (evita o corte para ~8k)
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_MAX_LOADED_MODELS=2"
Environment="OLLAMA_KEEP_ALIVE=30m"
Environment="OLLAMA_HOST=127.0.0.1:11434"

[Install]
WantedBy=multi-user.target
