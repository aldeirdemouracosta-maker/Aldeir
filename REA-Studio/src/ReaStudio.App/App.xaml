<Application x:Class="ReaStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Fundo" Color="#08242B"/>
        <SolidColorBrush x:Key="Painel" Color="#0E3B43"/>
        <SolidColorBrush x:Key="Azul" Color="#1E88E5"/>
        <SolidColorBrush x:Key="Texto" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextoSuave" Color="#BFE3EA"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Texto}"/></Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource Texto}"/><Setter Property="Margin" Value="0,3"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Azul}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="Black"/></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="Black"/></Style>
    </Application.Resources>
</Application>
