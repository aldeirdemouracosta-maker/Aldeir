<Window x:Class="ReaStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REA Studio Multi-IA" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="{StaticResource Fundo}" FontSize="14">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
        </Grid.RowDefinitions>

        <!-- Barra lateral -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource Painel}" Padding="10" Margin="0,0,8,0">
            <StackPanel>
                <TextBlock Text="REA Studio" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock Text="Projetos" FontWeight="SemiBold"/>
                <TextBlock Text="(gerenciador de projetos não implementado)" TextWrapping="Wrap" Foreground="{StaticResource TextoSuave}" FontSize="12" Margin="0,2,0,12"/>
                <TextBlock Text="Ferramentas" FontWeight="SemiBold"/>
                <Button Content="_Abrir pasta de binários…" Command="{Binding OpenFolderCommand}" TabIndex="0"
                        AutomationProperties.Name="Abrir pasta de binários"/>
                <Button Content="_Diagnóstico" Command="{Binding DiagnoseCommand}" TabIndex="1"
                        AutomationProperties.Name="Executar diagnóstico de REA, Ghidra e Ollama"/>
                <Button Content="Analisar com REA (não implementado)" IsEnabled="False" ToolTip="Requer cliente REA validado" Margin="0,3"/>
                <TextBlock Text="🛡 Permissões controladas" Margin="0,16,0,0" FontSize="12" Foreground="{StaticResource TextoSuave}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Centro: arquivos + funções -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{StaticResource Painel}" Padding="8" Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Arquivos binários (PE/ELF)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding Files}" TabIndex="2" AutomationProperties.Name="Lista de arquivos binários">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Foreground="Black" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Format}" Foreground="#005A8C"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource Painel}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Funções e pseudocódigo" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FunctionsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Painel de funções e pseudocódigo"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Direita: IA + chat -->
        <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource Painel}" Padding="10" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Gerenciador de IA" FontWeight="Bold" FontSize="16" Margin="0,0,0,6"/>
                    <RadioButton Content="_Automático — provedor escolhido com fallback local" IsChecked="{Binding IsAutomatic}" GroupName="modo" TabIndex="3"/>
                    <RadioButton Content="_Manual — só o provedor e modelo escolhidos" IsChecked="{Binding IsManual}" GroupName="modo" TabIndex="4"/>
                    <RadioButton Content="_Somente local — nada sai do computador" IsChecked="{Binding IsLocalOnly}" GroupName="modo" TabIndex="5"/>
                    <TextBlock Text="{Binding ModeHint}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextoSuave}" Margin="0,4,0,6"/>
                    <TextBlock Text="Provedor"/>
                    <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" DisplayMemberPath="Label" TabIndex="6" AutomationProperties.Name="Provedor de IA"/>
                    <TextBlock Text="{Binding SelectedProvider.Status}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextoSuave}" Margin="0,2,0,4"/>
                    <TextBlock Text="Modelo do provedor em nuvem (digite o id)"/>
                    <TextBox Text="{Binding CloudModel, UpdateSourceTrigger=PropertyChanged}" TabIndex="7" AutomationProperties.Name="Modelo do provedor em nuvem"/>
                    <TextBlock Text="Modelo Ollama (local / fallback)"/>
                    <ComboBox ItemsSource="{Binding OllamaModels}" SelectedItem="{Binding SelectedModel}" TabIndex="7" AutomationProperties.Name="Modelo Ollama"/>
                </StackPanel>
                <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" TabIndex="9" Margin="0,0,6,0" AutomationProperties.Name="Mensagem"/>
                    <Button Grid.Column="1" Content="_Enviar" Command="{Binding SendCommand}" TabIndex="10" Margin="0"/>
                </Grid>
                <ListBox ItemsSource="{Binding Chat}" TabIndex="8" Margin="0,6,0,0" AutomationProperties.Name="Conversa">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Who}" Foreground="#005A8C" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding Text}" Foreground="Black" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Inferior: terminal, tarefas, diagnóstico -->
        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Painel}" Padding="8" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Terminal de resultados" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Terminal, Mode=OneWay}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" TabIndex="11" AutomationProperties.Name="Terminal de resultados"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource Painel}" Padding="8" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Tarefas" FontWeight="SemiBold"/>
                    <ListBox ItemsSource="{Binding Tasks}" TabIndex="12" AutomationProperties.Name="Tarefas">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Foreground="Black" TextWrapping="Wrap"><Run Text="{Binding Title, Mode=OneWay}"/> — <Run Text="{Binding Status, Mode=OneWay}"/></TextBlock></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource Painel}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Diagnóstico" FontWeight="SemiBold"/>
                    <ListBox ItemsSource="{Binding Diagnostics}" TabIndex="13" AutomationProperties.Name="Diagnóstico">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Foreground="Black" TextWrapping="Wrap"><Run Text="{Binding Status, Mode=OneWay}" FontWeight="Bold"/> <Run Text="{Binding Component, Mode=OneWay}"/>: <Run Text="{Binding Detail, Mode=OneWay}"/></TextBlock></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
