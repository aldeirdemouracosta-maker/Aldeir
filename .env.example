# Copie para .env se quiser (o .env real NUNCA vai para o Git). Todos são opcionais.
# Rede / provedor
SWARM_HOST=127.0.0.1
SWARM_PORT=8000
SWARM_PROVIDER=ollama                  # ollama | local_compatible (LM Studio, llama-server)
SWARM_PROVIDER_URL=http://127.0.0.1:11434
SWARM_EMBED_MODEL=nomic-embed-text:latest
# Execução controlada
SWARM_MAX_CONCURRENT=2
SWARM_MAX_QUEUE=16
SWARM_JOB_TIMEOUT=120                  # segundos executando
SWARM_QUEUE_TIMEOUT=60                 # segundos esperando vaga/RAM na fila
SWARM_HEADROOM_MB=1024                 # RAM que nunca é reservada
SWARM_COORD_DIR=                       # pasta compartilhada entre processos cooperativos (vazio = desligado)
# Configuração alternativa (pasta com agents.yaml, models.yaml e evals/); vazio = a do pacote
SWARM_CONFIG_DIR=
# Dados locais (padrão em ~/.swarm)
SWARM_STATE=
SWARM_MEDIA=
SWARM_MODELS_DIR=
# Pesos opcionais (pastas/arquivos locais; o projeto nunca baixa sozinho)
SWARM_VISION_MODEL=
SWARM_SPEECH_MODEL=
SWARM_VOICE_MODEL=
SWARM_VOICE_VOICES=
SWARM_OCR_DET=
SWARM_OCR_REC=
SWARM_CLIP_MODEL=
