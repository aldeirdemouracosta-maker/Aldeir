#!/bin/sh
# Codice: barra commit com segredos (precisa do gitleaks; sem ele, so avisa).
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact || { echo "commit bloqueado: segredo encontrado" >&2; exit 1; }
else
  echo "aviso: gitleaks nao instalado; commit sem varredura de segredos" >&2
fi
