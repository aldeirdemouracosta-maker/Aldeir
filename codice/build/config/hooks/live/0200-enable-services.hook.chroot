#!/bin/sh
systemctl enable cpu-performance.service || true
systemctl enable zramswap.service || true
systemctl enable nftables.service || true
systemctl enable unattended-upgrades.service || true
sed -i 's/^# *pt_BR.UTF-8/pt_BR.UTF-8/' /etc/locale.gen && locale-gen || true
chmod 600 /etc/skel/.config/codice/chaves.env || true
systemctl enable llama-server.service || true
