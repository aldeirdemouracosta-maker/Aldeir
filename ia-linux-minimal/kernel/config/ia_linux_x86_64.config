# Fragmento base de configuração do kernel — IA Linux Minimal
# Linux 6.18.52 LTS. Aplicado a QEMU e a alvos físicos; particularidades de
# hardware físico (AMDGPU, NVMe, USB) ficam em physical.fragment.
#
# Uso: BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG + BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES
# (ver buildroot/configs/*_defconfig). Este arquivo não é um .config completo;
# é a base sobre a qual os fragments e `make olddefconfig` completam o resto.

# Console e init
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# cgroups v2 — AI Resource Manager (isolamento de agentes/tarefas)
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y

# eBPF / sched_ext — base para o futuro AI Scheduler (etapa 0.7)
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_HAVE_EBPF_JIT=y
CONFIG_BPF_EVENTS=y
# CONFIG_SCHED_CLASS_EXT is not set
# desligado por padrão nesta etapa; habilitado explicitamente pelo fragmento
# kernel/config/sched-ext.fragment quando o AI Scheduler experimental for
# ligado (0.7). Ver kernel/patches/README.md.

# DAMON — base para a futura AI Memory (etapa 0.6)
CONFIG_DAMON=y
CONFIG_DAMON_VADDR=y
CONFIG_DAMON_PADDR=y
CONFIG_DAMON_SYSFS=y
CONFIG_DAMON_RECLAIM=y

# zram — swap comprimido para hardware com pouca RAM
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_EROFS_FS=y
# EROFS reservado para a futura partição SYSTEM somente-leitura (0.1B+)

# rede básica (llama-server local, sincronização futura de modelos)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y

# módulos
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
