# IA Linux Minimal — alvo PC físico x86_64, boot BIOS legado (GRUB)
# Buildroot 2026.08 / Linux 6.18 LTS
# Inclui: SATA/AHCI, NVMe, USB, AMDGPU/Radeon, Mesa RADV, Vulkan, llama.cpp Vulkan

BR2_x86_64=y
BR2_X86_CPU_HAS_SSE4=y

BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y

BR2_TARGET_GENERIC_HOSTNAME="ia-linux"
BR2_TARGET_GENERIC_ISSUE="IA Linux Minimal"
BR2_INIT_BUSYBOX=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_GENERIC_GETTY_PORT="tty1"

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.52"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_IA_LINUX_PATH)/kernel/config/ia_linux_x86_64.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_IA_LINUX_PATH)/kernel/config/physical.fragment"
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# Firmware AMDGPU (linux-firmware — blob redistribuível, ver docs/licenses.md)
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU=y

# GRUB2 — boot BIOS legado
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="part_msdos ext2 fat biosdisk"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_PC="$(BR2_EXTERNAL_IA_LINUX_PATH)/buildroot/board/ia-linux/grub.cfg"

# Partições / imagem de disco via genimage
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2048M"
BR2_TARGET_ROOTFS_EXT2_LABEL="IA_SYSTEM"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_IA_LINUX_PATH)/buildroot/board/ia-linux/post-image.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT_ARGS="bios"

# Mesa RADV + Vulkan
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=n
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_AMD=y
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_VULKAN_HEADERS=y
BR2_PACKAGE_VULKAN_TOOLS=y

# llama.cpp CPU + Vulkan
BR2_PACKAGE_LLAMA_CPP=y
BR2_PACKAGE_LLAMA_CPP_VULKAN=y
BR2_PACKAGE_LLAMA_CPP_TOOLS=y

# Drivers de armazenamento/USB/rede
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_USBUTILS=y

# cgroups v2 / eBPF / zram
BR2_PACKAGE_LIBBPF=y
BR2_PACKAGE_BPFTOOL=y

# Pacotes próprios
BR2_PACKAGE_AI_CORE=y
BR2_PACKAGE_AI_SHELL=y

# Overlay
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_IA_LINUX_PATH)/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_IA_LINUX_PATH)/buildroot/board/ia-linux/post-build.sh"
