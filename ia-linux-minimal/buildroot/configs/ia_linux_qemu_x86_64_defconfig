# IA Linux Minimal — alvo QEMU x86_64 (desenvolvimento, CPU-only)
# Buildroot 2026.08 / Linux 6.18 LTS

BR2_x86_64=y
BR2_X86_CPU_HAS_SSE4=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y

# Sistema
BR2_TARGET_GENERIC_HOSTNAME="ia-linux"
BR2_TARGET_GENERIC_ISSUE="IA Linux Minimal"
BR2_INIT_BUSYBOX=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_ROOT_PASSWD=""

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.52"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_IA_LINUX_PATH)/kernel/config/ia_linux_x86_64.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_IA_LINUX_PATH)/kernel/config/qemu.fragment"
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# Sem GPU virtual no QEMU (decisão intencional — ver docs/architecture.md)
# BR2_PACKAGE_MESA3D is not set

# Filesystem imagens
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"

# BusyBox + utilitários mínimos
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# Pacotes de IA
BR2_PACKAGE_LLAMA_CPP=y
# BR2_PACKAGE_LLAMA_CPP_VULKAN is not set
BR2_PACKAGE_LLAMA_CPP_TOOLS=y

# Pacotes próprios (BR2_EXTERNAL)
BR2_PACKAGE_AI_CORE=y
BR2_PACKAGE_AI_SHELL=y

# Overlay
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_IA_LINUX_PATH)/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_IA_LINUX_PATH)/buildroot/board/ia-linux/post-build.sh"

# cgroups v2 / eBPF / zram (preparação para AI Resource Manager e AI Scheduler)
BR2_PACKAGE_LIBBPF=y
BR2_PACKAGE_BPFTOOL=y

# Ferramentas de diagnóstico mínimas
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
