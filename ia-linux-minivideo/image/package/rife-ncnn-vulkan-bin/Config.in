config BR2_PACKAGE_RIFE_NCNN_VULKAN_BIN
	bool "rife-ncnn-vulkan (binário oficial)"
	depends on BR2_x86_64
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_GCC_ENABLE_OPENMP # libgomp
	select BR2_PACKAGE_VULKAN_LOADER
	help
	  Interpolação de quadros RIFE (ncnn + Vulkan), binário do release
	  oficial 20221029 (Ubuntu, glibc >= 2.15). Instala só o modelo
	  rife-v4.6 em /usr/share/minivideo/modelos/rife/.

	  https://github.com/nihui/rife-ncnn-vulkan

comment "rife-ncnn-vulkan precisa de glibc, C++ e OpenMP (BR2_GCC_ENABLE_OPENMP)"
	depends on BR2_x86_64
	depends on !BR2_TOOLCHAIN_USES_GLIBC || !BR2_INSTALL_LIBSTDCPP || !BR2_GCC_ENABLE_OPENMP
