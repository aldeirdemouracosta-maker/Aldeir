config BR2_PACKAGE_AUTO_EDITOR_BIN
	bool "auto-editor (binário oficial)"
	depends on BR2_x86_64
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_GCC_ENABLE_OPENMP # libgomp
	help
	  Remove silêncios e trechos parados de vídeos. Binário oficial
	  (traz o próprio FFmpeg embutido). Testado nesta sessão em CPU
	  SandyBridge/IvyBridge emulada: sem instruções AVX2.

	  https://github.com/WyattBlue/auto-editor

comment "auto-editor precisa de glibc, C++ e OpenMP (BR2_GCC_ENABLE_OPENMP)"
	depends on BR2_x86_64
	depends on !BR2_TOOLCHAIN_USES_GLIBC || !BR2_INSTALL_LIBSTDCPP || !BR2_GCC_ENABLE_OPENMP
