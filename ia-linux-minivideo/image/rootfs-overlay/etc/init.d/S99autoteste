#!/bin/sh
# S99autoteste — só roda com "minivideo.autoteste=1" na linha do kernel (CI/QEMU).
# Exercita o espaço de usuário do ISO e imprime "AUTOTESTE: OK" ou
# "AUTOTESTE: FALHOU <etapa>" no console; depois desliga a máquina.

grep -q "minivideo.autoteste=1" /proc/cmdline || exit 0
[ "$1" = "start" ] || exit 0

say() { echo "AUTOTESTE: $*" > /dev/console; }
fail() { say "FALHOU $*"; sync; poweroff -f; exit 1; }

W=/tmp/autoteste
mkdir -p "$W"
say "início (kernel $(uname -r))"
cat /etc/minivideo-release > /dev/console

for b in minivideo-modelos minivideo-prompts minivideo-atualizar minivideo-diagnostico minivideo-preparar-disco minivideo-wifi wpa_supplicant iw xinit Xorg fluxbox startfluxbox pcmanfm xterm llama-bench ffmpeg ffprobe mpv auto-editor whisper-cli llama-server rife-ncnn-vulkan realesrgan-ncnn-vulkan \
         vulkaninfo minivideo-ui minivideo-agentes minivideo-guard minivideo-audit; do
    command -v "$b" >/dev/null || fail "binário ausente: $b"
done
say "binários presentes"

# Bibliotecas dos binários pré-compilados resolvem (libgomp, libvulkan, glibc).
# Buildroot não instala o script ldd: usa o carregador do glibc diretamente.
LDSO="$(ls /lib64/ld-linux-x86-64.so.2 /lib/ld-linux-x86-64.so.2 2>/dev/null | head -1)"
[ -n "$LDSO" ] || fail "carregador ld-linux-x86-64.so.2 ausente"
for b in rife-ncnn-vulkan realesrgan-ncnn-vulkan auto-editor; do
    libs="$("$LDSO" --list "$(command -v $b)" 2>&1)" || { echo "$libs" > /dev/console; fail "ld.so --list falhou em $b"; }
    if echo "$libs" | grep -q "not found"; then
        echo "$libs" > /dev/console
        fail "bibliotecas faltando em $b"
    fi
done
say "bibliotecas dos binários NCNN ok"

minivideo-audit > "$W/audit.txt" 2>&1 || fail "minivideo-audit"
cat "$W/audit.txt" > /dev/console
minivideo-agentes --workspace "$W/ws" dispositivos > /dev/console 2>&1 || fail "minivideo-agentes dispositivos"
minivideo-guard detect > /dev/console 2>&1 || say "guard: nenhuma GPU AMD (esperado em VM)"

ffmpeg -v error -y -f lavfi -i testsrc2=size=320x180:rate=12 -f lavfi -i sine=frequency=440 \
    -t 4 -c:v libx264 -pix_fmt yuv420p -c:a aac "$W/clipe.mp4" || fail "ffmpeg gerar clipe"
minivideo-agentes --workspace "$W/ws" executar "$W/clipe.mp4" \
    "corte 00:00:01 até 00:00:03, limpe o áudio e converta para 144p sem IA" \
    -o "$W/saida.mp4" --job-id autoteste --confirmar > /dev/console 2>&1 || fail "pipeline de agentes (ffmpeg)"
ffprobe -v error -show_entries stream=codec_name,height:format=duration -of compact "$W/saida.mp4" > /dev/console \
    || fail "ffprobe da saída"

# Especialistas: dry-run completo (Diretor, Editor, Fiscal) e edição de duas cenas sem CUDA
minivideo-agentes --workspace "$W/ws" especialistas planejar \
    "cena 1: 00:00:00 até 00:00:01.5 limpe o áudio; cena 2: 00:00:02 até 00:00:03.5 converta para 144p sem IA" \
    --entrada "$W/clipe.mp4" > /dev/console 2>&1 || fail "especialistas planejar"
minivideo-agentes --workspace "$W/ws" especialistas editar "$W/clipe.mp4" \
    "cena 1: 00:00:00 até 00:00:01.5 limpe o áudio; cena 2: 00:00:02 até 00:00:03.5 converta para 144p sem IA" \
    -o "$W/especialistas.mp4" --confirmar > /dev/console 2>&1 || fail "especialistas editar"
J="$(ls -d "$W"/ws/Jobs/esp-*/job.json | tail -1)"
minivideo-agentes --workspace "$W/ws" especialistas reproduzir "$J" -o "$W/rep.mp4" --confirmar \
    > /dev/console 2>&1 || fail "especialistas reproduzir"
minivideo-agentes motores > /dev/console
minivideo-modelos --workspace "$W/ws" catalogo > /dev/console 2>&1 || fail "minivideo-modelos catalogo"

# Assistente de prompts (perguntas guiadas, sem LLM) e atualizações (sem rede: só o que é local)
printf 'um barco navegando no mar\n/pronto\n' | minivideo-prompts conversar --modo regras \
    --salvar "$W/ws/Projetos/teste" > /dev/console 2>&1 || fail "minivideo-prompts conversar"
ls "$W"/ws/Projetos/teste/prompts/*-wan2.2-ti2v-5b.json > /dev/null 2>&1 || fail "prompt não foi salvo"
minivideo-atualizar --workspace "$W/ws" caminhos > /dev/console 2>&1 || fail "minivideo-atualizar caminhos"
python3 -c "from minivideo_atualizacoes import indice; assert len(indice.carregar_fontes()) >= 5" \
    || fail "fontes de atualização não carregam"
# Relatório de hardware (na VM não há GPU: os testes de GPU saem AUSENTE/FALHOU, sem derrubar o comando)
minivideo-diagnostico --relatorio --workspace "$W/ws" > /dev/console 2>&1 || fail "minivideo-diagnostico"
ls "$W"/ws/Logs/diagnostico-*.txt > /dev/null 2>&1 || fail "relatório de diagnóstico não foi gravado"
minivideo-preparar-disco listar > /dev/console 2>&1 || fail "minivideo-preparar-disco listar"
minivideo-wifi estado > /dev/console 2>&1 || fail "minivideo-wifi estado"
# Modo gráfico: o Xorg precisa subir de verdade (na VM, vídeo bochs pelo modesetting)
# (o busybox do ISO não tem "timeout": espera manual de até 90 s)
xinit /usr/bin/xdpyinfo -- /usr/bin/Xorg :5 vt5 -ac -nolisten tcp > "$W/xorg.log" 2>&1 &
XPID=$!; i=0
while kill -0 "$XPID" 2>/dev/null && [ "$i" -lt 90 ]; do sleep 1; i=$((i + 1)); done
kill "$XPID" 2>/dev/null
if grep -q "dimensions:" "$W/xorg.log"; then
    say "Xorg iniciou: $(grep dimensions: "$W/xorg.log" | head -1 | tr -s ' ')"
else
    cat "$W/xorg.log" > /dev/console; tail -40 /var/log/Xorg.5.log > /dev/console 2>&1
    fail "Xorg não inicia"
fi
# A sessão de verdade (a mesma da entrada "Interface"): Fluxbox, PCManFM e a janela MiniVideo
# como o usuário minivideo. Espera até 150 s (a VM da CI não tem KVM).
MINIVIDEO_HOME="$W/ws" xinit /usr/libexec/minivideo/sessao-grafica -- /usr/bin/Xorg :6 vt6 -ac -nolisten tcp \
    > "$W/sessao.log" 2>&1 &
SPID=$!; i=0; faltam="fluxbox pcmanfm xterm"
while [ -n "$faltam" ] && [ "$i" -lt 150 ] && kill -0 "$SPID" 2>/dev/null; do
    sleep 1; i=$((i + 1)); f2=""
    for p in $faltam; do pidof "$p" > /dev/null || f2="$f2 $p"; done
    faltam="${f2# }"
done
if [ -z "$faltam" ]; then
    say "sessão gráfica: fluxbox, pcmanfm e xterm (MiniVideo) rodando em ${i} s"
    kill "$SPID" 2>/dev/null; sleep 2
else
    cat "$W/sessao.log" > /dev/console; tail -30 /var/log/Xorg.6.log > /dev/console 2>&1
    fail "sessão gráfica: não subiu ($faltam)"
fi
# Na CI há um disco SATA vazio só para isto (minivideo.autoteste.disco=sda): prepara de verdade e confere
DISCO="$(sed -n 's/.*minivideo\.autoteste\.disco=\([a-z0-9]*\).*/\1/p' /proc/cmdline)"
if [ -n "$DISCO" ]; then
    minivideo-preparar-disco preparar "$DISCO" --confirmar "APAGAR $DISCO" > /dev/console 2>&1 \
        || fail "minivideo-preparar-disco preparar $DISCO"
    [ "$(findfs LABEL=MV_DADOS 2>/dev/null)" = "/dev/${DISCO}1" ] || fail "MV_DADOS não encontrada após preparar"
    [ -d /data/minivideo/Ferramentas ] || fail "/data/minivideo não foi ativada"
    say "disco $DISCO preparado como MV_DADOS"
fi

python3 -c "import curses, minivideo_ui.app" || fail "interface (curses) não importa"
whisper-cli --help > /dev/null 2>&1 || fail "whisper-cli não executa"
llama-server --version > /dev/console 2>&1 || fail "llama-server não executa"

say "OK"
sync
poweroff -f
