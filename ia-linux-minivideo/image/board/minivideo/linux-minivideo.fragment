# IA-Linux MiniVideo — fragmento de kernel ADITIVO sobre o kernel do IA Linux
# Minimal (6.18.52 + ia_linux_x86_64.config + physical.fragment). Nada aqui
# desliga o que a base liga; só acrescenta o que edição de vídeo precisa.

# Boot pelo ISO: rootfs inteiro no initramfs. Com isso /lib/firmware já existe
# quando o amdgpu (embutido na base) sobe — o firmware da Polaris carrega.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Boot UEFI: o GRUB EFI do ISO carrega o kernel pelo stub EFI. Sem framebuffer
# do firmware (simpledrm) a tela fica preta em UEFI até o amdgpu assumir, e no
# modo de recuperação (nomodeset) ficaria preta para sempre.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y

# Wi-Fi: Intel (iwlwifi), Qualcomm/Atheros, Realtek (rtw88 PCIe/USB, rtl8xxxu) e
# MediaTek MT7921/7922. Embutidos (=y): o firmware está no initramfs no boot.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLDVM=y
CONFIG_IWLMVM=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=y
CONFIG_ATH9K_PCI=y
CONFIG_ATH9K_HTC=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=y
CONFIG_RTW88=y
CONFIG_RTW88_8822BE=y
CONFIG_RTW88_8822CE=y
CONFIG_RTW88_8821CE=y
CONFIG_RTW88_8822BU=y
CONFIG_RTW88_8821CU=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=y
CONFIG_MT7921U=y
CONFIG_MT7601U=y

# Sistema em squashfs dentro do ISO (CD ou pendrive), com camada de escrita
# overlay na RAM: o initramfs mínimo monta tudo e faz switch_root.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_BLK_DEV_SR=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_USB_UAS=y

# Console na tela depois que o amdgpu assume o vídeo (prévia com mpv --vo=drm)
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Sensores lidos pelo Hardware Safety Guard (somente leitura)
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=y

# Áudio: placa-mãe (HDA Realtek), HDMI/DP da RX 580 e microfones USB
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_HDMI_GENERIC=y
CONFIG_SND_HDA_CODEC_HDMI_ATI=y
CONFIG_SND_USB_AUDIO=y

# Rede cabeada para baixar modelos: a base pede E1000/E1000E/R8169, mas sem
# NETDEVICES/ETHERNET/NET_VENDOR_* o olddefconfig descarta os três em
# silêncio (conferido contra o Linux 6.18.52 real nesta sessão).
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y

# Mídia em pendrives/HDs externos (FAT/exFAT/NTFS) com nomes em UTF-8
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# ---- Preparação para hardware futuro (não usado pela RX 580/X79) ----
# APU AMD (Ryzen com gráficos integrados): mesmo amdgpu; plataforma e sensores AMD
CONFIG_CPU_SUP_AMD=y
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_AMD_IOMMU=y
CONFIG_SENSORS_K10TEMP=y
# NVIDIA/CUDA: o driver (módulos abertos da NVIDIA) é externo e carregado
# como módulo; nouveau fica desligado para não disputar a GPU.
# CONFIG_DRM_NOUVEAU is not set
